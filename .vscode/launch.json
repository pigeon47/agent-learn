{
  // 按 F5（调试）或 Ctrl+F5（不调试直接跑）时用哪个配置
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: 当前文件",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}", // 跑当前打开的那个文件，不用改路径
      "console": "integratedTerminal", // 输出走终端，中文不乱码、input() 也能用
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    }
  ]
}
