# 复制本文件为 .env，然后把值换成你自己的。
#   Copy-Item .env.example .env
#   notepad .env
#
# .env 已被仓库根目录的 .gitignore 忽略，永远不会被提交。
# 本文件（.env.example）只放键名和占位符，是可以提交的。

# 在 https://platform.deepseek.com/api_keys 申请
DEEPSEEK_API_KEY=sk-在这里填你的密钥

DEEPSEEK_BASE_URL=https://api.deepseek.com

# 2026 版只有这两个模型可选，练手用 flash（便宜）
DEEPSEEK_MODEL=deepseek-flash

# 单次请求的读取超时（秒）。
# httpx 默认只有 5 秒，调 LLM 经常不够，尤其开了思考模式，所以显式放大。
DEEPSEEK_TIMEOUT=60
