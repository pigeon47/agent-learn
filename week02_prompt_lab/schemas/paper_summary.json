{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PaperSummary",
  "description": "论文摘要抽取结果。只能写摘要里明确出现的信息；没有就填 null / 空数组。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "authors",
    "year",
    "method",
    "contributions",
    "limitations",
    "keywords"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200,
      "description": "论文标题原文"
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "type": "string", "minLength": 2 },
      "description": "作者姓名列表，按摘要中出现的顺序。英文名保留原文，不要翻译"
    },
    "year": {
      "type": ["integer", "null"],
      "minimum": 1900,
      "maximum": 2100,
      "description": "发表年份；摘要里没有明确年份时填 null，禁止猜"
    },
    "method": {
      "type": "string",
      "minLength": 5,
      "maxLength": 200,
      "description": "一句话概括核心方法（30~60 字），不要抄整段原文"
    },
    "contributions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": { "type": "string", "minLength": 4, "maxLength": 120 },
      "description": "2~4 条主要贡献，每条一句"
    },
    "limitations": {
      "type": "array",
      "maxItems": 3,
      "items": { "type": "string", "minLength": 4, "maxLength": 120 },
      "description": "局限/不足；摘要没提就给空数组"
    },
    "keywords": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": { "type": "string", "minLength": 2, "maxLength": 20 },
      "description": "3~5 个主题关键词"
    },
    "reasoning": {
      "type": "string",
      "maxLength": 1200,
      "description": "仅 CoT 写法使用：先写提取提纲，再给字段。其他写法不要输出这个字段"
    }
  }
}
